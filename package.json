{
  "name": "superapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n mobile,pwa -c cyan,magenta \"npm run dev:mobile\" \"npm run dev:pwa\"",
    "dev:mobile": "npm run start --workspace @superapp/mobile",
    "dev:pwa": "npm run dev --workspace @superapp/pwa",
    "build": "npm run build:pwa && npm run build:mobile",
    "build:mobile": "npm run build --workspace @superapp/mobile",
    "build:pwa": "npm run build --workspace @superapp/pwa",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:packages && npm run test:pwa && npm run test:mobile",
    "test:packages": "node --test packages/api-client/mocks/index.test.mjs",
    "test:pwa": "npm run test --workspace @superapp/pwa",
    "test:mobile": "npm run test --workspace @superapp/mobile",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
